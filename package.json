    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/gallery.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
